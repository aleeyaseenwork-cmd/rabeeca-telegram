# ----- Database backend -----
# sqlite = zero setup, one file (default). mongodb = needs MONGODB_URI below.
DB_BACKEND=mongodb
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net
MONGODB_DB_NAME=telegram_sub_bot

# ----- Google Sheets live backup (optional, on top of MongoDB) -----
# The actual credentials live in database/google_service_account.json
# (a real file, not here) because private keys break in .env files.
# Only the sheet ID goes here:
GOOGLE_SHEET_ID=your-google-sheet-id-from-the-url
GOOGLE_SHEETS_ENABLED=1

# ----- Dashboard -----
DASHBOARD_PASSWORD=changeme
SECRET_KEY=change-this-to-a-random-string
PORT=5000
FLASK_DEBUG=0

# The public URL people reach the dashboard at. Put your real domain here
# once you have one, e.g. https://dashboard.yourdomain.com (see README "Domain setup").
DASHBOARD_URL=http://localhost:5000

# ----- Telegram Bot -----
BOT_TOKEN=your-telegram-bot-token-from-botfather
# Fallback only. Set the real one in the dashboard: Settings -> Telegram group / channel ID
GROUP_CHAT_ID=

# ----- Stripe (test mode keys to start) -----
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ----- CardBilling / Verotel (FlexPay) -----
# From Verotel Control Center -> Setup Websites -> your shop's FlexPay options
VEROTEL_SHOP_ID=your-shop-id
VEROTEL_SIGNATURE_KEY=your-signature-key
